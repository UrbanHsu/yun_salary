rules_version = '2';

// 惠韻牙醫診所 助理薪資系統＋員工每月回饋
// 使用方式：把 allowed() 裡的 Email 換成實際要放行的管理者帳號，
// 然後在 Firebase 主控台 → Firestore Database → 規則，整段貼上並「發布」。

service cloud.firestore {
  match /databases/{database}/documents {

    // 管理者（Google 帳號白名單）
    // 用 get() 讀 email：LINE 登入的助理沒有 email，直接讀會出錯
    function allowed() {
      return request.auth != null
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('email', '') in [
             'EMAIL_1@gmail.com',
             'EMAIL_2@gmail.com'
           ];
    }
    // 員工有兩種登入方式：
    // 1. 從 LINE 推播卡片打開（LIFF）：推播中心發的 custom token，帶 sys 與 staffId，沒有 email
    // 2. 一般瀏覽器：「代號@staff.yun-salary.app」帳號＋密碼
    function isLineStaff() {
      return request.auth != null
        && request.auth.token.get('sys', '') == 'huiyun'
        && request.auth.token.get('staffId', null) is string;
    }
    function isPwStaff() {
      return request.auth != null
        && request.auth.token.get('email', '').matches('^[a-z0-9]+@staff[.]yun-salary[.]app$');
    }
    function isStaff() { return isLineStaff() || isPwStaff(); }
    function staffId() {
      return isLineStaff() ? request.auth.token.staffId
                           : request.auth.token.email.split('@')[0];
    }

    // 薪資主檔（payroll/state）：只有管理者
    match /payroll/{doc} {
      allow read, write: if allowed();
    }

    // 填單名單（只有名字，給員工登入頁選名字用）
    match /meta/roster {
      allow read: if true;
      allow write: if allowed();
    }
    // 誰已設定過密碼：所有人可看，員工只能加自己
    match /meta/registry {
      allow read: if true;
      allow create, update: if allowed() || (isStaff()
        && request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys().hasOnly([staffId()]));
      allow delete: if allowed();
    }
    // 每月回饋：forms/{YYYYMM}_{代號}，員工只能讀寫自己那份
    match /forms/{docId} {
      allow read, write: if allowed()
        || (isStaff() && docId.matches('^[0-9]{6}_' + staffId() + '$'));
    }
    // 出缺勤登記：attendance/{YYYYMM}，只有名單上指定的負責人與管理者可以讀寫
    match /attendance/{month} {
      allow read, write: if allowed()
        || (isStaff() && get(/databases/$(database)/documents/meta/roster).data.attendanceBy == staffId());
    }
    // 填寫進度（只有誰已送出）：所有人可看，員工只能把自己標成已送出
    match /formStatus/{month} {
      allow read: if true;
      allow create: if allowed() || (isStaff() && request.resource.data.submitted.keys().hasOnly([staffId()]));
      allow update: if allowed() || (isStaff()
        && request.resource.data.submitted.diff(resource.data.submitted).affectedKeys().hasOnly([staffId()]));
      allow delete: if allowed();
    }

    // 其他路徑一律禁止
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
